# Gmail SMTP Configuration for Vercel Serverless Function (/api/contact)
# Use your Google Account email
GMAIL_USER=your-email@gmail.com

# 16-character Google App Password (generated via Google Account -> Security -> 2-Step Verification -> App Passwords)
# Do NOT use your normal Gmail account password!
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Destination email where inquiries should be received (defaults to GMAIL_USER if omitted)
CONTACT_RECEIVER_EMAIL=your-email@gmail.com
